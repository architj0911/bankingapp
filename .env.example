# ===============================================
# APEXBANK CONFIGURATION ENVIRONMENT VARIABLES
# ===============================================

# Copy to .env on the host and replace every placeholder. Never commit .env.

# Required production database secret (use a long random value)
POSTGRES_PASSWORD=replace-with-a-unique-long-random-password
CONFIG_SERVER_USERNAME=replace-with-config-server-username
CONFIG_SERVER_PASSWORD=replace-with-config-server-password
CONFIG_GIT_URI=https://github.com/your-org/your-config-repo.git
CONFIG_GIT_BRANCH=main
CONFIG_GIT_USERNAME=
CONFIG_GIT_PASSWORD=
JWT_RSA_PRIVATE_KEY_BASE64=generate-and-paste-PKCS8-DER-base64
JWT_RSA_PUBLIC_KEY_BASE64=generate-and-paste-matching-X509-DER-base64
JWT_KEY_ID=apexbank-key-1

# SMTP Mail Server Configuration for Email OTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=ApexBank Security

# KYC provider credentials; leave empty for demo mode
SETU_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PAN_PRODUCT_ID=
SETU_DIGILOCKER_PRODUCT_KEY=
SETU_CALLBACK_URL=https://your-domain.example/api/kyc/callback

# Domain pointed to the production host; Caddy obtains and renews HTTPS certificates.
SITE_DOMAIN=bank.example.com
WEB_PORT=8088

# KYC Provider Configuration (demo / production)
KYC_PAN_PROVIDER=demo
KYC_AADHAAR_PROVIDER=demo

# PostgreSQL username is postgres in the current compose stack.

# Redis Cache & Session Configuration
# Internal Docker service names; normally leave these defaults.
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka Messaging Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
